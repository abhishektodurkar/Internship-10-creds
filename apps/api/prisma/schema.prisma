generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleScope {
  SYSTEM
  COMPANY
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

model Company {
  id             String          @id @default(cuid())
  name           String
  industryKey    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  users          User[]
  departments    Department[]
  employees      Employee[]
  companyModules CompanyModule[]
  documents      Document[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([industryKey])
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String
  status        UserStatus  @default(ACTIVE)
  companyId     String
  roleId        String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  company       Company     @relation(fields: [companyId], references: [id])
  role          Role        @relation(fields: [roleId], references: [id])
  aiChatHistory AIChat[]

  @@index([companyId])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  scope       RoleScope        @default(COMPANY)
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Department {
  id        String   @id @default(cuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  employees Employee[]
}

model Employee {
  id           String       @id @default(cuid())
  companyId    String
  departmentId String?
  fullName     String
  createdAt    DateTime     @default(now())
  company      Company      @relation(fields: [companyId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  attendance   Attendance[]
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  checkInAt  DateTime
  checkOutAt DateTime?
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, checkInAt])
}

model CompanyModule {
  id        String   @id @default(cuid())
  companyId String
  key       String
  enabled   Boolean  @default(true)
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model Document { id String @id @default(cuid()) companyId String path String company Company @relation(fields:[companyId], references:[id]) createdAt DateTime @default(now()) }
model Notification { id String @id @default(cuid()) companyId String title String body String company Company @relation(fields:[companyId], references:[id]) createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) companyId String actorUserId String action String entity String entityId String company Company @relation(fields:[companyId], references:[id]) createdAt DateTime @default(now()) }
model Supplier { id String @id @default(cuid()) companyId String name String createdAt DateTime @default(now()) }
model Vehicle { id String @id @default(cuid()) companyId String registrationNo String createdAt DateTime @default(now()) }
model Driver { id String @id @default(cuid()) companyId String name String createdAt DateTime @default(now()) }
model Warehouse { id String @id @default(cuid()) companyId String name String createdAt DateTime @default(now()) }
model Inventory { id String @id @default(cuid()) companyId String sku String quantity Int @default(0) createdAt DateTime @default(now()) }
model Shipment { id String @id @default(cuid()) companyId String trackingNo String status String createdAt DateTime @default(now()) }
model ProductionBatch { id String @id @default(cuid()) companyId String batchNo String status String createdAt DateTime @default(now()) }
model MachineLog { id String @id @default(cuid()) companyId String machineCode String runtimeMinutes Int @default(0) downtimeMinutes Int @default(0) createdAt DateTime @default(now()) }
model Analytics { id String @id @default(cuid()) companyId String metricKey String metricValue Json createdAt DateTime @default(now()) }
model AIChat { id String @id @default(cuid()) userId String companyId String question String answer String createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id]) }
